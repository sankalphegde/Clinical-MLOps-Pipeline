FROM python:3.12-slim

RUN pip install --no-cache-dir mlflow==3.15.1

EXPOSE 5000

# The api/dashboard/airflow containers run as different (non-root) users but
# share this volume directly (MLflow's local artifact repo needs filesystem
# access, not just the HTTP API) — so it needs to be writable by all of them.
CMD mkdir -p /mlflow/artifacts && chmod -R 777 /mlflow && \
    mlflow server \
    --backend-store-uri sqlite:////mlflow/mlflow.db \
    --default-artifact-root /mlflow/artifacts \
    --host 0.0.0.0 --port 5000 \
    --allowed-hosts "mlflow,mlflow:5000,localhost,localhost:5001"
